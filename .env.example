# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Set this to your live domain when deploying (no trailing slash)
# Local:      http://localhost:3000
# Production: https://your-app.onrender.com
BASE_URL=http://localhost:3000

# Must be a long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-string-at-least-32-chars

# ── ClickUp OAuth App ─────────────────────────────────────────────────────────
# Create at: https://app.clickup.com/settings/apps → "Create an App"
# Set Redirect URL to: {BASE_URL}/auth/clickup/callback
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

# ── Todoist OAuth App ─────────────────────────────────────────────────────────
# Create at: https://app.todoist.com/app/settings/integrations/developer
# Set OAuth Redirect URL to: {BASE_URL}/auth/todoist/callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
